{
  "name": "@lvce-editor/viewlet-registry-monorepo",
  "version": "0.0.0-dev",
  "description": "Viewlet Registry Monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/lvce-editor/viewlet-registry.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.js",
    "format": "prettier --write .",
    "lint": "eslint . && knip --no-config-hints",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 130
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.6.0",
    "@lvce-editor/eslint-plugin-github-actions": "^17.6.0",
    "eslint": "^10.8.0",
    "knip": "^6.29.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
